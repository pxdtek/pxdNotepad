<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>pxdNotepad</RootNamespace>
    <AssemblyName>pxdNotepad</AssemblyName>
    <StartupObject>pxdNotepad.Program</StartupObject>
    <Version>1.11.0</Version>
    <Product>pxd Notepad</Product>
    <Company>pxd</Company>
    <Copyright>pxd</Copyright>
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- The benchmark (pxdNotepad.exe with the bench switch) is only built on request: dotnet publish -c Release -p:PxdBench=true -->
  <PropertyGroup Condition="'$(PxdBench)' == 'true'">
    <DefineConstants>$(DefineConstants);BENCH</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(PxdBench)' != 'true'">
    <Compile Remove="Bench.cs" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

</Project>
